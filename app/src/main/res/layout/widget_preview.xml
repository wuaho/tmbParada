<?xml version="1.0" encoding="utf-8"?>
<!-- Static sample shown in the widget picker on Android 12+ (previewLayout). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/preview_background"
    android:orientation="vertical"
    android:padding="12dp"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Selva de Mar - Perú"
                android:textColor="@color/preview_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/preview_status"
                android:textColor="@color/preview_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/preview_refresh_background"
            android:contentDescription="@null"
            android:padding="10dp"
            android:src="@drawable/ic_refresh"
            android:tint="@color/preview_accent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="44dp"
            android:layout_height="24dp"
            android:background="@drawable/preview_badge"
            android:backgroundTint="#2E8B3E"
            android:gravity="center"
            android:text="V29"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Diagonal Mar"
            android:textColor="@color/preview_text"
            android:textSize="13sp" />

        <TextView
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="19 min"
            android:textColor="@color/preview_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="5 min"
            android:textColor="@color/preview_accent"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="44dp"
            android:layout_height="24dp"
            android:background="@drawable/preview_badge"
            android:backgroundTint="#1D5DA8"
            android:gravity="center"
            android:text="H16"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Pg. Zona Franca"
            android:textColor="@color/preview_text"
            android:textSize="13sp" />

        <TextView
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text=""
            android:textColor="@color/preview_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="2 min"
            android:textColor="@color/preview_accent"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="44dp"
            android:layout_height="24dp"
            android:background="@drawable/preview_badge"
            android:backgroundTint="#C8231B"
            android:gravity="center"
            android:text="7"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Zona Universitària"
            android:textColor="@color/preview_text"
            android:textSize="13sp" />

        <TextView
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="21 min"
            android:textColor="@color/preview_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="12 min"
            android:textColor="@color/preview_accent"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
